APP_NAME=Foodhunts
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=foodhunts
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=localhost

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
STORE_URL=http://localhost:3002
FOODHUNTS_DEFAULT_DELIVERY_FEE=0
FOODHUNTS_SERVICE_FEE_RATE=0.05

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

EXPO_ACCESS_TOKEN=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_TIMEOUT=5
SUPABASE_AUTH_CONNECT_TIMEOUT=3

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_USE_PATH_STYLE_ENDPOINT=false
MEDIA_STORAGE_DRIVER=legacy
MEDIA_PRIVATE_URL_TTL_MINUTES=10
MEDIA_PUBLIC_IMAGE_MAX_KB=5120
MEDIA_PRIVATE_DOCUMENT_MAX_KB=10240

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@foodhunts.app"
MAIL_FROM_NAME="${APP_NAME}"

PUSH_PROVIDER=expo
